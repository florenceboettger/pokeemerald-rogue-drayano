include partials/vars

doctype html

html(language="en")
    head
        title="Emerald Rogue Rebalanced Documentation"
    body
        h1 List of Pokemon
        each d in data.dexNums
            div 
                a(href=`pokemon/${data.pokemonList[d].modifiedDexNum}.html`) #{data.pokemonList[d].speciesName}